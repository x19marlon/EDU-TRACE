# EDU-TRACE — Environment Variables
# Copy to .env and fill in your values.

# Go server
# 127.0.0.1 = solo accesible desde este equipo. Usa 0.0.0.0 solo detrás de un proxy HTTPS.
HOST=127.0.0.1
PORT=8080
GPP_PATH=g++
COMPILE_TIMEOUT_SECS=10
RUN_TIMEOUT_SECS=5
MAX_OUTPUT_SIZE=10240
ALLOWED_ORIGINS=http://localhost:3000

# Aislamiento del código de los estudiantes: "bwrap" (requiere bubblewrap) o "none" (solo desarrollo)
SANDBOX=bwrap

# Autenticación
# DATA_DIR guarda usuarios y sesiones (edutrace.json).
# TEACHER_CODE es el código secreto para crear cuentas docentes; vacío = no se pueden crear.
# COOKIE_SECURE=true cuando se sirva por HTTPS.
DATA_DIR=data
SESSION_TTL_HOURS=72
TEACHER_CODE=
COOKIE_SECURE=false

# Ollama (local LLM for AI feedback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=180
OLLAMA_CONTEXT_SIZE=8192

# Telegram bot (Python — existing)
TELEGRAM_BOT_TOKEN=
MONGODB_URI=
TELEGRAM_ALLOWED_USER_IDS=
