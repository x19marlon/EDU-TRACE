{$EDUTRACE_DOMINIO} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	log {
		output file /var/log/caddy/edutrace.log {
			roll_size 10MiB
			roll_keep 10
		}
	}
}

{$EDUTRACE_DOMINIO_PRUEBAS:pruebas.localhost} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Robots-Tag "noindex"
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8081 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3001
	}
}
